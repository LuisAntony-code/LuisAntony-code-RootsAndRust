# ===============================================================
#  Roots & Rust - Atributos de Git
#  - Texto normalizado (LF) para scripts y archivos de Unity.
#  - UnityYAMLMerge para escenas, prefabs y assets serializados.
#  - Git LFS para binarios pesados.
# ===============================================================
* text=auto

# --- Código y texto ---
*.cs        text diff=csharp eol=lf
*.shader    text eol=lf
*.hlsl      text eol=lf
*.cginc     text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.asmdef    text eol=lf

# --- Archivos YAML de Unity: fusión inteligente con UnityYAMLMerge ---
# (configura el driver "unityyamlmerge" en tu .gitconfig, ver README)
*.unity       merge=unityyamlmerge eol=lf linguist-generated
*.prefab      merge=unityyamlmerge eol=lf linguist-generated
*.asset       merge=unityyamlmerge eol=lf linguist-generated
*.mat         merge=unityyamlmerge eol=lf linguist-generated
*.anim        merge=unityyamlmerge eol=lf linguist-generated
*.controller  merge=unityyamlmerge eol=lf linguist-generated
*.overrideController merge=unityyamlmerge eol=lf linguist-generated
*.physicMaterial merge=unityyamlmerge eol=lf linguist-generated
*.meta        merge=unityyamlmerge eol=lf
*.playable    merge=unityyamlmerge eol=lf linguist-generated
*.mask        merge=unityyamlmerge eol=lf linguist-generated
*.brush       merge=unityyamlmerge eol=lf linguist-generated
*.flare       merge=unityyamlmerge eol=lf linguist-generated
*.fontsettings merge=unityyamlmerge eol=lf linguist-generated
*.guiskin     merge=unityyamlmerge eol=lf linguist-generated
*.giparams    merge=unityyamlmerge eol=lf linguist-generated
*.renderTexture merge=unityyamlmerge eol=lf linguist-generated
*.spriteatlas merge=unityyamlmerge eol=lf linguist-generated
*.terrainlayer merge=unityyamlmerge eol=lf linguist-generated
*.shadervariants merge=unityyamlmerge eol=lf linguist-generated
*.preset      merge=unityyamlmerge eol=lf linguist-generated

# --- Git LFS: modelos 3D ---
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.FBX   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.max   filter=lfs diff=lfs merge=lfs -text
*.ma    filter=lfs diff=lfs merge=lfs -text
*.mb    filter=lfs diff=lfs merge=lfs -text

# --- Git LFS: texturas e imágenes ---
*.png   filter=lfs diff=lfs merge=lfs -text
*.PNG   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.tif   filter=lfs diff=lfs merge=lfs -text
*.tiff  filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text

# --- Git LFS: audio y video ---
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.aif   filter=lfs diff=lfs merge=lfs -text
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.mov   filter=lfs diff=lfs merge=lfs -text

# --- Git LFS: fuentes y otros binarios ---
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
*.dll   filter=lfs diff=lfs merge=lfs -text
*.so    filter=lfs diff=lfs merge=lfs -text
*.a     filter=lfs diff=lfs merge=lfs -text
*.zip   filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text
# Lightmaps / datos horneados
LightingData.asset filter=lfs diff=lfs merge=lfs -text
